#!/bin/sh
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev || mount -t tmpfs tmpfs /dev
mdev -s
[ -c /dev/console ] && exec </dev/console >/dev/console 2>&1
echo "VioletOS init ready"
if [ -f /drivers/load ]; then
 while read -r module; do insmod "/drivers/$module" || echo "Cannot load $module"; done </drivers/load
fi
while :; do
 mdev -s
 if [ -c /dev/fb0 ] || [ -c /dev/graphics/fb0 ]; then
  /bin/violet
 fi
 sleep 1
done
