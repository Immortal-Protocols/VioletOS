#!/usr/bin/env python3
"""Start the VioletOS phone-relay access point and run the HTTPS test through it.

Provisions a one-boot WPA2 profile named VioletRelay-XXXX (or VioletRelayOpen-XXXX
with --open), writes the join details for the companion app, then asks Radio to host
the network and fetch a UUID through the phone's SOCKS5 relay.
"""
import argparse
import hashlib
import json
import os
import secrets
import subprocess
import time
from pathlib import Path

BUILD = Path(__file__).resolve().parents[3] / "build"


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--open", action="store_true", help="host an open network")
    parser.add_argument("--details", type=Path, default=BUILD / "relay-pairing.json")
    parser.add_argument("--wait", type=int, default=200, help="seconds to wait for the result")
    args = parser.parse_args()
    tag = secrets.token_hex(2).upper()
    ssid = (f"VioletRelayOpen-{tag}" if args.open else f"VioletRelay-{tag}").encode()
    passphrase = secrets.token_urlsafe(12)
    pmk = hashlib.pbkdf2_hmac("sha1", passphrase.encode(), ssid, 4096, 32)
    details = {"ssid": ssid.decode(), "passphrase": "" if args.open else passphrase,
               "socks_user": "violet", "socks_password": pmk[:8].hex()}
    args.details.write_text(json.dumps(details, indent=2) + "\n")
    nonce = (secrets.randbelow(0xFFFFFFFE) + 1).to_bytes(4, "little")
    record = nonce + bytes([len(ssid)]) + ssid.ljust(32, b"\0") + pmk + int(time.time()).to_bytes(4, "little")
    subprocess.run([BUILD / "moto-package", "provision-wpa2"], input=record, check=True)
    print(f"Hosting {ssid.decode()}; pairing details in {args.details}", flush=True)
    result = subprocess.run([BUILD / "moto-package", "join-wifi"], env={**os.environ, "MOTO_WIFI_WAIT": str(args.wait)})
    raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
