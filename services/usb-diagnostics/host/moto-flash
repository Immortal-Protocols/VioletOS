#!/usr/bin/env python3
"""Flash a VioletOS boot image to slot B of the connected Moto without handset input.

From VioletOS, USB Diagnostics marks the MT6357 RTC fast-boot flag and resets,
so the bootloader starts fastboot. From Android on slot A, adb requests the
bootloader. If the running image cannot request fastboot, repeated VioletOS
reboots use up slot B's retries until the bootloader falls back to Android A.

Unless --wipe-storage is given, send a sparse image to slot B that skips saved
data and the installed app store. Stop if that image cannot be prepared or flashed.

--take-userdata ERASES ANDROID, once, when the owner has agreed: it writes
VioletOS's claim to the start of Android's userdata partition (23 GiB), where
the installed apps then live (they move from boot_b on the next start), and
puts the image in boot_a too, so the phone never boots Android and a bad
image in B falls back to a working VioletOS in A. --slot-a refreshes A later.
"""
import argparse
import json
import struct
import subprocess
import time
from pathlib import Path

BUILD = Path(__file__).resolve().parents[3] / "build"
START = time.monotonic()


def log(message):
    print(f"[{time.monotonic() - START:6.1f}s] {message}", flush=True)


def ok(*command, timeout=20):
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def violet():
    result = ok(BUILD / "moto-debug", timeout=10)
    if result and result.returncode == 0:
        try:
            return json.loads(result.stdout)
        except ValueError:
            pass
    return None


def in_fastboot():
    result = ok("fastboot", "devices", timeout=10)
    return bool(result and result.stdout.strip())


def moto_serial():
    """The adb serial of a Moto G Pure in Android, ignoring any other attached phone."""
    result = ok("adb", "devices", timeout=10)
    if not result:
        return None
    for line in result.stdout.splitlines():
        if not line.endswith("\tdevice"):
            continue
        serial = line.split("\t")[0]
        product = ok("adb", "-s", serial, "shell", "getprop", "ro.product.device", timeout=10)
        if product and product.stdout.strip() == "ellis":
            return serial
    return None


def in_android():
    return moto_serial() is not None


def adb_bootloader():
    serial = moto_serial()
    if serial:
        ok("adb", "-s", serial, "reboot", "bootloader")


def state():
    if in_fastboot():
        return "fastboot"
    if in_android():
        return "android"
    if violet():
        return "violet"
    return None


def wait_for(wanted, seconds):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        now = state()
        if now in wanted:
            return now
        time.sleep(1)
    return None


def to_fastboot(fallback_reboots):
    now = wait_for({"fastboot", "android", "violet"}, 30)
    if now == "violet":
        log("VioletOS answered; requesting fastboot over USB Diagnostics")
        request = ok(BUILD / "moto-package", "reboot-bootloader")
        if request and request.returncode == 0:
            now = wait_for({"fastboot", "android"}, 45)
        else:
            now = None
        for attempt in range(fallback_reboots):
            if now in ("fastboot", "android"):
                break
            # The running image cannot request fastboot. Each boot of B uses
            # one retry, after which the bootloader starts Android on A.
            log(f"Fastboot not reached; fallback reboot {attempt + 1}")
            ok(BUILD / "moto-package", "reboot")
            now = wait_for({"fastboot", "android"}, 50)
    if now == "android":
        log("Android answered; requesting the bootloader with adb")
        adb_bootloader()
        now = wait_for({"fastboot"}, 60)
    if now != "fastboot":
        raise SystemExit("The handset did not reach fastboot")
    log("Fastboot reached")


def fastboot(*args):
    result = subprocess.run(["fastboot", *args], capture_output=True, text=True, timeout=300)
    output = (result.stdout + result.stderr).strip()
    if result.returncode:
        raise SystemExit(f"fastboot {' '.join(args)} failed:\n{output}")
    return output


STORAGE_MARKER = b"VioletOS XT2163DL boot_b storage v1\n"
MARKER_OFFSET = 16 * 1024 * 1024  # platform/sel4/loader/build.py
STORAGE_BYTES = 1024 * 1024
APPS_OFFSET = 20 * 1024 * 1024  # targets/moto-g-pure/storage_volume.rs
BOOT_B_BYTES = 32 * 1024 * 1024  # targets/moto-g-pure/storage_volume.rs


def keep_storage(image):
    """A sparse copy of `image` that skips the storage window, or None."""
    data = image.read_bytes()
    marker = data[MARKER_OFFSET:MARKER_OFFSET + 512]
    if not marker.startswith(STORAGE_MARKER) or any(marker[len(STORAGE_MARKER):]):
        return None
    block = 512  # the window starts one sector after the marker
    start = (MARKER_OFFSET + 512) // block
    count = STORAGE_BYTES // block
    if len(data) % block or not (start + count) * block < len(data) <= APPS_OFFSET:
        return None
    total = len(data) // block
    chunks = []
    def raw(first, n):
        body = data[first * block:(first + n) * block]
        chunks.append(struct.pack("<HHII", 0xCAC1, 0, n, 12 + len(body)) + body)
    raw(0, start)
    chunks.append(struct.pack("<HHII", 0xCAC3, 0, count, 12))  # don't care: left as it is
    raw(start + count, total - start - count)
    # The rest of boot_b holds installed apps (runtime/open/appstore.rs): leave it too.
    tail = BOOT_B_BYTES // block - total
    if tail > 0:
        chunks.append(struct.pack("<HHII", 0xCAC3, 0, tail, 12))
        total += tail
    header = struct.pack("<IHHHHIIII", 0xED26FF3A, 1, 0, 28, 12, block, total, len(chunks), 0)
    out = BUILD / "moto-flash-keep-storage.simg"
    out.write_bytes(header + b"".join(chunks))
    return out


def getvar(name):
    """A bootloader variable, or None if this bootloader does not answer it
    (another MBM build, or the AOSP spelling without the underscore)."""
    result = ok("fastboot", "getvar", name, timeout=30)
    if not result or result.returncode:
        return None
    for line in (result.stdout + result.stderr).splitlines():
        if line.startswith(f"{name}:"):
            return line.split(":", 2)[-1].strip()
    return None


def select_b(fallback_reboots):
    """Make B active with fresh tries.

    MBM restores B's tries (to 7) only when B is not already the current slot:
    `set_active b` on a current B with no tries left changes nothing, and the
    next boot then falls through to fastboot ("No bootable A/B slot"). Seen
    once (November 27, 2026, on the MBM the Moto README names): with neither
    slot bootable, one reboot fell through to fastboot with A current, after
    which `set_active b` restored B's tries. slot-bootable:_a is not a sure
    sign that A will not boot (A has reported "No" and still started a
    VioletOS), so the reboot may start A instead: VioletOS or Android is
    then taken back to fastboot, which makes A current all the same. A
    bootloader that does not answer the variables gets the plain
    `set_active b`, as before this check.
    """
    fastboot("set_active", "b")
    tries, a_bootable = getvar("slot-retry-count:_b"), getvar("slot-bootable:_a")
    if tries != "0" or a_bootable != "No":
        return
    log("Slot B has no tries left; rebooting once so the bootloader resets them")
    fastboot("reboot")
    now = wait_for({"fastboot", "violet", "android"}, 90)
    if now is None:
        raise SystemExit("After the reboot to reset slot B's tries the handset reached neither fastboot, "
                         "VioletOS nor Android. boot_b is written; reselect B from fastboot (fastboot set_active b).")
    if now != "fastboot":
        log(f"The bootloader started slot A ({now}), not fastboot; going back to fastboot")
        to_fastboot(fallback_reboots)
    fastboot("set_active", "b")
    tries = getvar("slot-retry-count:_b")
    log(f"Slot B tries: {tries}")
    if tries == "0":
        raise SystemExit("Slot B still has no tries after set_active b: it would not boot. boot_b is written and "
                         "the handset is in fastboot; check fastboot getvar all (slot-retry-count:_b).")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("image", nargs="?", type=Path, default=BUILD / "sel4/moto/boot.img")
    parser.add_argument("--fallback-reboots", type=int, default=8,
                        help="VioletOS reboots to try if fastboot is not requested directly")
    parser.add_argument("--fastboot-only", action="store_true",
                        help="stop in fastboot without flashing")
    parser.add_argument("--wipe-storage", action="store_true",
                        help="also erase the handset's saved app data and Wi-Fi networks")
    parser.add_argument("--take-userdata", action="store_true",
                        help="ERASES ANDROID: claim its userdata partition for VioletOS's apps and put VioletOS in slot A too")
    parser.add_argument("--slot-a", action="store_true",
                        help="also flash the image to slot A, VioletOS's fallback")
    args = parser.parse_args()
    if not args.fastboot_only and not args.image.is_file():
        raise SystemExit(f"{args.image} not found")
    sparse = None
    if not args.fastboot_only and not args.wipe_storage:
        sparse = keep_storage(args.image)
        if sparse is None:
            raise SystemExit("Could not prepare a storage-preserving image. Flash stopped.")
    to_fastboot(args.fallback_reboots)
    if args.fastboot_only:
        return
    if sparse is not None:
        log(f"Flashing {args.image} to boot_b, keeping the saved data")
        fastboot("flash", "boot_b", str(sparse))
    else:
        log(f"Flashing {args.image} to boot_b with --wipe-storage")
        fastboot("flash", "boot_b", str(args.image))
    if args.take_userdata:
        # The claim: the tag in userdata's first sector, zeros after (no move recorded yet).
        tag = b"VioletOS XT2163DL userdata v1\n"  # targets/moto-g-pure/storage_volume.rs
        claim = BUILD / "moto-userdata-claim.img"
        claim.write_bytes(tag + bytes(4096 - len(tag)))
        log("Claiming userdata for VioletOS (Android's data is erased)")
        fastboot("flash", "userdata", str(claim))
    if args.take_userdata or args.slot_a:
        log(f"Flashing {args.image} to boot_a, the fallback slot")
        fastboot("flash", "boot_a", str(args.image))
    select_b(args.fallback_reboots)
    log("Slot B selected; rebooting")
    fastboot("reboot")
    # A first boot can fall back to Android (for example after a warm reset with
    # the Wi-Fi domain powered). Reselect B from fastboot once before giving up.
    for attempt in range(2):
        # The first start after --take-userdata copies the installed apps (about two minutes).
        deadline = time.monotonic() + (300 if args.take_userdata else 90)
        while time.monotonic() < deadline:
            snapshot = violet()
            if snapshot and snapshot.get("runtime_ready"):
                keys = ("generation", "disk_ready", "startup_status", "previous_boot_stage")
                log("VioletOS answered: " + json.dumps({k: snapshot.get(k) for k in keys}))
                # The Wi-Fi profile lasts one boot: provision the one saved on this Mac.
                profile = Path(__file__).with_name("moto-wifi-profile")
                if (Path.home() / ".config/violetos/wifi-profile.json").exists():
                    result = ok(profile, "--saved", timeout=30)
                    log("Saved Wi-Fi profile provisioned" if result and result.returncode == 0
                        else "Could not provision the saved Wi-Fi profile")
                return
            if in_android():
                break
            time.sleep(1)
        else:
            raise SystemExit("VioletOS did not answer over USB after the flash")
        if attempt:
            raise SystemExit("The handset started Android on A instead of VioletOS")
        log("Android on A answered; reselecting slot B from fastboot")
        adb_bootloader()
        if not wait_for(("fastboot",), 60):
            raise SystemExit("Fastboot did not appear after leaving Android")
        fastboot("set_active", "b")
        fastboot("reboot")


if __name__ == "__main__":
    main()
