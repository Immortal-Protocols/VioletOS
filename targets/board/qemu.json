{
  "name": "qemu",
  "title": "QEMU virt with the handset's memory map (AArch32, the default test target)",
  "arch": "aarch32",
  "cpu": "cortex-a53",
  "cores": 1,
  "kernel": {
    "platform": "ellis",
    "build": "kernel/sel4/build.py",
    "timer_hz": 62500000,
    "interrupt_controller": "gic-v3",
    "device_tree": "platform/sel4/board/qemu.dts"
  },
  "memory": {
    "ram": {
      "pa": "0x40000000",
      "size": "0x40000000",
      "what": "RAM QEMU gives the machine (-m 1G)"
    },
    "kernel_ram": [
      {
        "pa": "0x40000000",
        "size": "0x01000000"
      },
      {
        "pa": "0x41300000",
        "size": "0x00d00000"
      },
      {
        "pa": "0x42700000",
        "size": "0x01500000"
      }
    ],
    "regions": {
      "kernel": {
        "pa": "0x40000000",
        "size": "0x00100000",
        "what": "kernel image"
      },
      "root": {
        "pa": "0x40200000",
        "size": "0x00180000",
        "va": "0x00100000",
        "what": "the supervisor's image and stack"
      },
      "staging": {
        "pa": "0x45000000",
        "size": "0x02000000",
        "what": "where QEMU loads the boot image before the entry stub copies it"
      },
      "initfs": {
        "pa": "0x4a000000",
        "size": "0x06000000",
        "what": "open apps' file system image"
      },
      "app_pool_low": {
        "pa": "0x50000000",
        "size": "0x08000000",
        "what": "open-app memory pool, first block"
      },
      "app_pool_high": {
        "pa": "0x60000000",
        "size": "0x10000000",
        "what": "open-app memory pool, second block"
      },
      "camera": {
        "pa": "0x78000000",
        "size": "0x00400000",
        "what": "camera frame memory"
      },
      "framebuffer": {
        "pa": "0x79450000",
        "size": "0x00fb0000",
        "what": "the screen, read by the tests from guest memory"
      }
    }
  },
  "devices": {
    "touch_fixture": {
      "kind": "pl011 (touch SPI fixture)",
      "pa": "0x09000000",
      "size": "0x1000",
      "windows": [
        {
          "owner": "touch",
          "va": "0x09003000",
          "frames": 1,
          "rights": "rw"
        }
      ]
    },
    "storage": {
