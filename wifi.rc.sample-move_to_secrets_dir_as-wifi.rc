# Wi-Fi settings for services/usb-diagnostics/host/moto-wifi-profile.
#
# Copy this file to secrets/wifi.rc (git ignores secrets/), fill it in, then:
#
#     source secrets/wifi.rc
#     services/usb-diagnostics/host/moto-wifi-profile --save
#
# Keep the "export": without it the script does not see the variable.
# The script asks for whichever one is left empty.

# The network's name, 1 to 32 bytes. For example: export VIOLET_SSID='Home Wi-Fi'
export VIOLET_SSID=''

# Its WPA2 password, 8 to 63 printable ASCII characters.
export VIOLET_WIFIPASS=''

# The phone is a private client unless told otherwise: it joins under a random
# Wi-Fi address each time Wi-Fi starts and gives the network no name. To have a
# router know it again (an address reservation, a firewall rule), fill in an
# address, a name or both, and set VIOLET_IS_PRIVATE_CLIENT to 0.

# The phone's Wi-Fi address, such as 02:11:22:33:44:55 (an even first byte).
export VIOLET_FIXED_MAC=''

# The name the phone gives the network with DHCP: 1 to 32 letters, digits or hyphens.
export VIOLET_HOSTNAME=''

# 0, no, false, off or disable: use the two above. Empty or 1: a private client.
export VIOLET_IS_PRIVATE_CLIENT=''
